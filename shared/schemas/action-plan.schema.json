{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://autocad-ai-agent.local/schemas/action-plan.schema.json",
    "title": "Action Plan",
    "description": "Validated action plan proposed by AI server for plugin execution.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "request_id",
        "actions"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "request_id": {
            "type": "string",
            "minLength": 1
        },
        "summary": {
            "type": "string"
        },
        "needs_clarification": {
            "type": "boolean",
            "default": false
        },
        "clarification_question": {
            "type": "string"
        },
        "goal_plan": {
            "$ref": "#/$defs/goalPlan"
        },
        "task_graph": {
            "$ref": "#/$defs/taskGraph"
        },
        "actions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/action"
            }
        }
    },
    "$defs": {
        "point2d": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "x",
                "y"
            ],
            "properties": {
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                }
            }
        },
        "action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "args"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "insert_block",
                        "create_polyline",
                        "update_attribute",
                        "find_entities"
                    ]
                },
                "reason": {
                    "type": "string"
                },
                "args": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/insertBlockArgs"
                        },
                        {
                            "$ref": "#/$defs/createPolylineArgs"
                        },
                        {
                            "$ref": "#/$defs/updateAttributeArgs"
                        },
                        {
                            "$ref": "#/$defs/findEntitiesArgs"
                        }
                    ]
                }
            }
        },
        "insertBlockArgs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "position"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "position": {
                    "$ref": "#/$defs/point2d"
                },
                "layer": {
                    "type": "string"
                },
                "rotation_deg": {
                    "type": "number"
                },
                "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            }
        },
        "createPolylineArgs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "vertices"
            ],
            "properties": {
                "vertices": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                        "$ref": "#/$defs/point2d"
                    }
                },
                "layer": {
                    "type": "string"
                },
                "closed": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "updateAttributeArgs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "target_handle",
                "tag",
                "value"
            ],
            "properties": {
                "target_handle": {
                    "type": "string",
                    "minLength": 1
                },
                "tag": {
                    "type": "string",
                    "minLength": 1
                },
                "value": {
                    "type": "string"
                }
            }
        },
        "findEntitiesArgs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "entity_type"
            ],
            "properties": {
                "entity_type": {
                    "type": "string",
                    "enum": [
                        "block",
                        "text",
                        "line",
                        "polyline"
                    ]
                },
                "layer": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "text_contains": {
                    "type": "string"
                }
            }
        },
        "goalSubgoal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "title",
                "status",
                "kind"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "pending",
                        "running",
                        "done",
                        "failed"
                    ]
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "analysis",
                        "clarification",
                        "execution",
                        "verification",
                        "report"
                    ]
                },
                "action_id": {
                    "type": "string"
                }
            }
        },
        "goalPlan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "version",
                "goal",
                "status",
                "subgoals"
            ],
            "properties": {
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "goal": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "pending",
                        "running",
                        "done",
                        "failed"
                    ]
                },
                "subgoals": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/goalSubgoal"
                    }
                }
            }
        },
        "taskNode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "title",
                "kind",
                "status",
                "depends_on"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "analysis",
                        "clarification",
                        "action",
                        "verification",
                        "report"
                    ]
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "pending",
                        "running",
                        "done",
                        "failed"
                    ]
                },
                "action_id": {
                    "type": "string"
                },
                "depends_on": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "taskEdge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "from",
                "to",
                "type"
            ],
            "properties": {
                "from": {
                    "type": "string",
                    "minLength": 1
                },
                "to": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "depends_on"
                    ]
                }
            }
        },
        "taskGraph": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "version",
                "entrypoints",
                "terminal_nodes",
                "nodes",
                "edges"
            ],
            "properties": {
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "entrypoints": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "terminal_nodes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "execution_order": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "nodes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/taskNode"
                    }
                },
                "edges": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/taskEdge"
                    }
                }
            }
        }
    }
}