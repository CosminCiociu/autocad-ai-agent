{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://autocad-ai-agent.local/schemas/dwg-context.schema.json",
    "title": "DWG Context",
    "description": "Input context extracted from AutoCAD DWG for AI analysis.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "request_id",
        "drawing",
        "blocks",
        "texts",
        "lines",
        "polylines"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "request_id": {
            "type": "string",
            "minLength": 1
        },
        "drawing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "units",
                "coordinate_system"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "units": {
                    "type": "string",
                    "enum": [
                        "unitless",
                        "mm",
                        "cm",
                        "m",
                        "inch",
                        "foot"
                    ]
                },
                "coordinate_system": {
                    "type": "string",
                    "enum": [
                        "WCS",
                        "UCS"
                    ]
                },
                "extents": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "min": {
                            "$ref": "#/$defs/point2d"
                        },
                        "max": {
                            "$ref": "#/$defs/point2d"
                        }
                    }
                },
                "layers": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "name"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "color_index": {
                                "type": "integer"
                            },
                            "on": {
                                "type": "boolean"
                            },
                            "frozen": {
                                "type": "boolean"
                            },
                            "locked": {
                                "type": "boolean"
                            }
                        }
                    }
                },
                "block_definitions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "name"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "description": {
                                "type": "string"
                            },
                            "is_dynamic": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        },
        "blocks": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "handle",
                    "name",
                    "layer",
                    "position"
                ],
                "properties": {
                    "handle": {
                        "type": "string",
                        "minLength": 1
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "layer": {
                        "type": "string",
                        "minLength": 1
                    },
                    "rotation_deg": {
                        "type": "number"
                    },
                    "scale": {
                        "type": "number"
                    },
                    "color_index": {
                        "type": "integer"
                    },
                    "is_dynamic": {
                        "type": "boolean"
                    },
                    "description": {
                        "type": "string"
                    },
                    "position": {
                        "$ref": "#/$defs/point2d"
                    },
                    "attributes": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "tag",
                                "value"
                            ],
                            "properties": {
                                "tag": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "value": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "texts": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "handle",
                    "value",
                    "layer",
                    "position"
                ],
                "properties": {
                    "handle": {
                        "type": "string",
                        "minLength": 1
                    },
                    "value": {
                        "type": "string"
                    },
                    "value_plain": {
                        "type": "string"
                    },
                    "layer": {
                        "type": "string",
                        "minLength": 1
                    },
                    "height": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    },
                    "style": {
                        "type": "string"
                    },
                    "color_index": {
                        "type": "integer"
                    },
                    "position": {
                        "$ref": "#/$defs/point2d"
                    }
                }
            }
        },
        "lines": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "handle",
                    "layer",
                    "start",
                    "end"
                ],
                "properties": {
                    "handle": {
                        "type": "string",
                        "minLength": 1
                    },
                    "layer": {
                        "type": "string",
                        "minLength": 1
                    },
                    "start": {
                        "$ref": "#/$defs/point2d"
                    },
                    "end": {
                        "$ref": "#/$defs/point2d"
                    },
                    "length": {
                        "type": "number",
                        "minimum": 0
                    },
                    "color_index": {
                        "type": "integer"
                    },
                    "linetype": {
                        "type": "string"
                    }
                }
            }
        },
        "polylines": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "handle",
                    "layer",
                    "vertices"
                ],
                "properties": {
                    "handle": {
                        "type": "string",
                        "minLength": 1
                    },
                    "layer": {
                        "type": "string",
                        "minLength": 1
                    },
                    "closed": {
                        "type": "boolean",
                        "default": false
                    },
                    "area": {
                        "type": "number",
                        "minimum": 0
                    },
                    "color_index": {
                        "type": "integer"
                    },
                    "linetype": {
                        "type": "string"
                    },
                    "vertices": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                            "$ref": "#/$defs/point2d"
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "point2d": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "x",
                "y"
            ],
            "properties": {
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                }
            }
        }
    }
}